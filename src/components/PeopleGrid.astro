---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";

const people = await getPublishedCollection("people");

const roleOrder: Record<string, number> = {
  convenor: 0,
  tutor: 1,
  guest: 2,
  other: 3,
};

// Map the role enum (convenor|tutor|guest|other) to display labels rather than
// rendering the raw lowercase value.
const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};

const visible = people.sort((a, b) => {
  const ra = roleOrder[a.data.role ?? "other"] ?? 99;
  const rb = roleOrder[b.data.role ?? "other"] ?? 99;
  if (ra !== rb) return ra - rb;
  return a.data.title.localeCompare(b.data.title);
});
---

<CardGrid columns={2}>
  {
    visible.map((person) => (
      <Card headingLevel="h2" title={person.data.title} href={`/people/${person.id}/`}>
        {person.data.role && roleLabels[person.data.role] && (
          <p>
            <small>{roleLabels[person.data.role]}</small>
          </p>
        )}
        <p>{person.data.description}</p>
        {(person.data.email || person.data.contact) && (
          <p>
            <small>{person.data.email ?? person.data.contact}</small>
          </p>
        )}
      </Card>
    ))
  }
</CardGrid>
